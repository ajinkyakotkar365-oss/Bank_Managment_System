# Database configuration
# Set DB_TYPE to 'mysql' to use MySQL, or leave as 'sqlite' (default)
DB_TYPE=sqlite

# MySQL configuration variables (required only if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bank_db

# Flask session security
SECRET_KEY=generate_a_secure_random_key_here
